<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.OPSC7312_POE" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <!-- Light Mode -->
    <!-- Screen background if light mode is selected -->
    <style name="SCREEN">
        <item name="android:background">#FFFFFF</item>
    </style>

    <!-- Text background if light mode is selected -->
    <style name="TEXT">
        <item name="android:textColor">#000000</item>
    </style>

    <!-- Button background if light mode is selected -->
    <style name="BUTTON">
        <item name="android:backgroundTint">@android:color/holo_blue_light</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Final theme definition that inherits from the base theme -->
    <style name="Theme.OPSC7312_POE" parent="Base.Theme.OPSC7312_POE" />
</resources>

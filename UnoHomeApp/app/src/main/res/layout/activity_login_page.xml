<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/SCREEN"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginPage">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="200dp"
        android:layout_height="250dp"
        android:layout_marginStart="118dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="132dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uno_home_logo" />

    <Button
        android:id="@+id/btn_fingerprint_signin"
        android:layout_width="320dp"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="25dp"
        android:text="@string/sign_in_with_fingerprint_button"
        android:backgroundTint="@color/black"
        android:textSize="20sp"
        app:cornerRadius="5dp"
        app:layout_constraintTop_toBottomOf="@id/imageView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnGoogleLogin"
        android:layout_width="320dp"
        android:layout_height="64dp"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="24dp"
        android:drawableLeft="@drawable/google_logo"
        android:text="@string/continue_with_google_button"
        android:backgroundTint="@color/black"
        android:textSize="20sp"
        app:cornerRadius="5dp"
        app:layout_constraintTop_toBottomOf="@id/btn_fingerprint_signin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
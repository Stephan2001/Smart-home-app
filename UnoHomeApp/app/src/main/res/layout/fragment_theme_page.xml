<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SCREEN"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ThemesPage">

    <TextView
        android:id="@+id/txtThemesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="150dp"
        android:layout_marginTop="50dp"
        android:text="@string/themes_title"
        style="@style/TEXT"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgProfileIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="294dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="7dp"
        android:contentDescription="Profile Icon"
        android:src="@drawable/imgprofilepic" />

    <ImageView
        android:id="@+id/imgIllustration"
        android:layout_width="396dp"
        android:layout_height="205dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Illustration"
        android:src="@drawable/imgautomation" />

    <ScrollView
        android:layout_width="377dp"
        android:layout_height="348dp"
        android:layout_above="@id/btnAddTheme"
        android:layout_below="@id/imgIllustration"
        android:layout_marginStart="16dp"
        android:layout_marginTop="-1dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="-4dp"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/lstThemes"
            style="@style/LIST"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="21dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:src="@drawable/imgaddicon" />
</RelativeLayout>

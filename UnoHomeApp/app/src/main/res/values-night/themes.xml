<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.OPSC7312_POE" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
    </style>

    <!-- Dark Mode -->
    <!-- Screen background if dark mode is selected -->
    <style name="SCREEN">
        <item name="android:background">#363636</item>
    </style>

    <!-- Text background if dark mode is selected -->
    <style name="TEXT">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Button background if dark mode is selected -->
    <style name="BUTTON">
        <item name="android:backgroundTint">@android:color/holo_blue_light</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- List background if dark mode is selected -->
    <style name="LIST">
        <item name ="android:textColor">#FFFFFF</item>
    </style>

</resources>
